# Shared building block for Lint-style visitors (backend/css.prog and backend/html2.prog both compose
# this in, rather than each hand-rolling its own `warnings := []` accumulator). `| Warnings_Visitor`
# gives a visitor a `warnings` member and a `warn` method to push onto it; the visitor's own
# `visit_*` methods call `warn(...)` as they walk the tree instead of building and returning their
# own local warnings array, so the caller just reads `.warnings` once the whole tree's been walked.
Warnings_Visitor {
	warnings := []

	warn ( message;
		self.warnings.push(message)
	)
}
