###
Reads a markdown task list and reports how many lines are still open (`+`) vs done (`-`).
Run from the repo root:
bin/prog examples/tasks/stats.prog
###

Task_List_Stats <name: String, open: Array, done: Array, open_percent: Flo, done_percent: Flo>

make_stats ( filepath: String -> Task_List_Stats;
	content := File.read(filepath)
	lines := content.split("\n")

	open := []
	done := []

	for lines
	    trimmed := it.trim()

	    if trimmed.start_with?('-')
			done.push(trimmed)
	    elif trimmed.start_with?('+')
	        open.push(trimmed)
	    end
	end

	done_count   := done.length()
	open_count   := open.length()
	total_count  := done_count + open_count
	done_percent := (done_count.to_f() / total_count.to_f() * 100.0).round()
	open_percent := (open_count.to_f() / total_count.to_f() * 100.0).round()

	# note; these arguments must be in this order, structs don't support named arguments
	# note; also commas are optional in this case
	Task_List_Stats(
		filepath.split('.').0
		open_count
		done_count
		open_percent
		done_percent
	)
)

files := ['examples/tasks/bugs.md' 'examples/tasks/design.md' 'examples/tasks/todos.md'] # note; optional commas
for files
	@puts make_stats(filepath := it).to_s(compact := false)
end
