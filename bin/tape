#!/usr/bin/env ruby

require_relative '../src/tape'

INSTRUCTIONS = <<~INST
    Usage:
        bundle exec bin/tape <file>          Execute tape file and keep running until interrupt
        bundle exec bin/tape [command]       Run command

    COMMANDS:
        run <file>            Execute tape file and keep running until interrupt
        check <file>          Run basic type check on file

        repl                  Enter repl mode, type code press enter

        interp <code>         Execute code string
        interpf <file>        Execute file

        parse <code>          Show AST for code
        parsef <file>         Show AST for file

        declare <code>        Show forward declarations for code
        declaref <file>       Show forward declarations for file

        lex <code>            Show lexer tokens for code
        lexf <file>           Show lexer tokens for file

		-p                    Print output created by program.
        -v | --version        Show version number
        -h | --help           Show help instructions

    EXAMPLES:
        tape learn/hello_world.tape -p
        tape lex "x = 5 + 3" -p
        tape parsef learn/hello_world.tape -p
        tape interp "4815" -p
INST

if ARGV.empty?
	puts INSTRUCTIONS
	exit 1
end

def interp_and_print_output source_code, file: nil, load_standard_library: true
	interpreter                       = Tape::Interpreter.new
	interpreter.load_standard_library = load_standard_library
	interpreter.register_source file, source_code if file
	result = interpreter.run source_code
	[interpreter, result]
end

begin
	print_output = ARGV.last == '-p'

	case ARGV[0]
	when '-v', '--version'
		puts "Tape #{Tape::VERSION}"
		exit 0
	when '-h', '--help'
		puts INSTRUCTIONS
		exit 0
	when 'repl'
		Tape::REPL.new.run
	when 'check'
		Tape.type_check ARGV[1]
	when 'lex'
		result = Tape.lex ARGV[1]
		pp result if print_output
	when 'parse'
		result = Tape.parse ARGV[1]
		pp result if print_output
	when 'interp'
		interpreter, result = interp_and_print_output ARGV[1]
		puts interpreter.stringify_for_display(result) if print_output
	when 'lexf'
		result = Tape.lex_file ARGV[1]
		pp result if print_output
	when 'parsef'
		result = Tape.parse_file ARGV[1]
		pp result if print_output
	when 'declare'
		result = Tape.declare ARGV[1]
		pp result if print_output
	when 'declaref'
		result = Tape.declare_file ARGV[1]
		pp result if print_output
	when 'interpf'
		result = Tape.interp_file ARGV[1]
		pp result if print_output
	when 'interp-nostd'
		interpreter, result = interp_and_print_output ARGV[1], load_standard_library: false
		puts interpreter.stringify_for_display(result) if print_output
	when 'interpf-nostd'
		interpreter, result = interp_and_print_output File.read(ARGV[1]), file: ARGV[1], load_standard_library: false
		puts interpreter.stringify_for_display(result) if print_output
	when 'run'
		interpreter, result = Tape::Hot_Reloader.new(ARGV[1]).run
		puts interpreter.stringify_for_display(result) if print_output && interpreter
	else
		if ARGV[0]
			interpreter, result = Tape::Hot_Reloader.new(ARGV[0]).run
			puts interpreter.stringify_for_display(result) if print_output && interpreter
		else
			puts "Error: No file specified.\n#{INSTRUCTIONS}"
			exit 1
		end
	end
rescue Errno::ENOENT => e
	$stderr.puts "Could not find file `#{ARGV[0]}`\n\n#{e.full_message}"
	exit 1

rescue Tape::Error => e
	$stderr.puts e.message
	exit 1
end
